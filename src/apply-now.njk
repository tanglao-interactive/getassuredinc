<section class="section">
  <div class="container split">
    <div>
      <h2>Before you apply</h2>
      <p>Have your contact information, purchase or refinance goal, estimated property location, and basic income details ready. A team member can help you understand which loan path fits your situation.</p>
      <ul class="check-list">
        <li>Conventional and jumbo mortgage options</li>
        <li>FHA and VA purchase loans</li>
        <li>Reverse mortgage and refinance guidance</li>
        <li>Non-QM, foreign national, and ITIN scenarios</li>
      </ul>
    </div>
    <form class="form-card" aria-label="Mortgage application starter form">
      <label>First name<input type="text" name="first_name" autocomplete="given-name" required></label>
      <label>Last name<input type="text" name="last_name" autocomplete="family-name" required></label>
      <label>Email<input type="email" name="email" autocomplete="email" required></label>
      <label>Phone<input type="tel" name="phone" autocomplete="tel" required></label>
      <label>Loan goal
        <select name="loan_goal">
          <option>Purchase</option>
          <option>Refinance</option>
          <option>Reverse mortgage</option>
          <option>Not sure yet</option>
        </select>
      </label>
      <label>Message<textarea name="message" rows="5"></textarea></label>
      <button class="btn btn--primary" type="submit">Submit Application Starter</button>
    </form>
  </div>
</section>
